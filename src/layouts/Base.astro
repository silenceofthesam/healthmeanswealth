---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Health Means Wealth — Heron Way Allotments, Feltham',
  description = 'Health Means Wealth is an inclusive community allotment group at Heron Way, Feltham. We grow fruit and vegetables, celebrate together, and welcome everyone.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/logos/hmw-icon-colour.svg" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Health Means Wealth" />
  <meta property="og:title" content="Health Means Wealth — Community Allotment Group, Feltham" />
  <meta property="og:description" content="An inclusive community allotment group at Heron Way, Feltham. Growing food, growing community — wheelchair accessible and open to all." />
  <meta property="og:url" content="https://healthmeanswealth.org.uk" />
  <meta property="og:image" content="https://healthmeanswealth.org.uk/logos/hmw-logo-pack/hmw-logo-horizontal-colour.png" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter/X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Health Means Wealth — Community Allotment Group, Feltham" />
  <meta name="twitter:description" content="An inclusive community allotment group at Heron Way, Feltham. Growing food, growing community." />
  <meta name="twitter:image" content="https://healthmeanswealth.org.uk/logos/hmw-logo-pack/hmw-logo-horizontal-colour.png" />

  <!-- Canonical -->
  <link rel="canonical" href="https://healthmeanswealth.org.uk" />

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Health Means Wealth',
    url: 'https://healthmeanswealth.org.uk',
    logo: 'https://healthmeanswealth.org.uk/logos/hmw-icon-colour.svg',
    email: 'hello@healthmeanswealth.org.uk',
    description: 'An inclusive community allotment group at Heron Way, Feltham, London.',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Heron Way Community Allotments',
      addressLocality: 'Feltham',
      addressRegion: 'London',
      addressCountry: 'GB',
    },
    sameAs: ['https://www.facebook.com/p/Health-means-Wealth-100083095098532/'],
  })} />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <slot />
  <script>
    // Scroll-reveal (skipped for reduced-motion users)
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const els = document.querySelectorAll('.pillar, .testimonial, .event-card, .update-card, .gallery-item, .contact-row');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
      els.forEach((el, i) => {
        el.classList.add('reveal');
        (el as HTMLElement).style.transitionDelay = `${(i % 4) * 60}ms`;
        io.observe(el);
      });
    }
  </script>
</body>
</html>
