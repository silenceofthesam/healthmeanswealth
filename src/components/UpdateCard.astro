---
export interface Props {
  title: string;
  date: Date;
  tag: string;
  slug: string;
  image?: string;
  image_alt?: string;
}
const { title, date, tag, slug, image, image_alt } = Astro.props;
const tagClass = {
  'Event recap':    'tag-event',
  'News':           'tag-news',
  'Growing season': 'tag-grow',
  'Community':      'tag-community',
};
---
<article class={`update-card${image ? ' has-image' : ''}`}>
  {image && (
    <div class="update-photo">
      <img src={image} alt={image_alt ?? ''} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="update-meta">
    <span class={`tag ${tagClass[tag] ?? 'tag-news'}`}>{tag}</span>
    <time datetime={date.toISOString().slice(0, 10)}>{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
  </div>
  <h3>{title}</h3>
  <div class="update-body"><slot /></div>
</article>

<style>
  .update-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--shadow-sm);
    height: 100%;
  }
  /* Photo sits flush with the card's top edge */
  .update-photo {
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) 6px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--color-green-pale);
  }
  .update-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .update-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .update-meta time {
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }
  .update-card h3 {
    font-family: var(--font-heading);
    font-size: var(--size-xl);
    font-weight: 600;
    line-height: 1.25;
  }
  .update-body :global(p) {
    font-size: var(--size-base);
    color: var(--color-text-muted);
    max-width: none;
  }
  .update-body :global(p + p) { margin-top: 0.8em; }
  .update-body :global(img) { border-radius: var(--radius-sm); margin: 0.8em 0; }
  .tag {
    display: inline-block;
    font-size: var(--size-xs);
    font-weight: var(--weight-bold);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .tag-event    { background: var(--color-tag-event-bg);     color: var(--color-tag-event-text); }
  .tag-news     { background: var(--color-tag-news-bg);      color: var(--color-tag-news-text); }
  .tag-grow     { background: var(--color-tag-grow-bg);      color: var(--color-tag-grow-text); }
  .tag-community{ background: var(--color-tag-community-bg); color: var(--color-tag-community-text); }
</style>
