---
---
<header class="nav-wrap">
  <nav class="nav" aria-label="Main">
    <a href="/#home" class="brand" aria-label="Health Means Wealth — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 200 200" width="30" height="30">
          <line x1="100" y1="180" x2="100" y2="44" stroke="currentColor" stroke-width="12" stroke-linecap="round"/>
          <path d="M100 120 C94 120 52 114 46 76 C46 76 76 60 100 96Z" fill="currentColor"/>
          <path d="M100 96 C106 96 148 88 154 50 C154 50 124 34 100 70Z" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Health Means Wealth</span>
        <span class="brand-sub">Heron Way Allotments · Feltham</span>
      </span>
    </a>
    <button class="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links" id="burger">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="nav-links" role="list">
      <li><a href="/#about">About</a></li>
      <li><a href="/#gallery">Gallery</a></li>
      <li><a href="/#events">Events</a></li>
      <li><a href="/#updates">Updates</a></li>
      <li><a href="/#find-us">Find us</a></li>
      <li><a href="/#contact" class="nav-cta">Get in touch</a></li>
    </ul>
  </nav>
</header>

<style>
  .nav-wrap {
    background: var(--color-green-dark);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow var(--transition-base);
  }
  .nav-wrap.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,0.25); }
  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* Wordmark — real text (crisp at any size, selectable, screen-reader friendly) */
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-white);
    min-width: 0;
  }
  .brand-mark {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 13px;
    background: var(--color-green-light);
    color: var(--color-green-dark);
    display: grid;
    place-items: center;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; min-width: 0; }
  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.2rem, 4.6vw, 1.6rem);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-sub {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green-light);
    margin-top: 4px;
    white-space: nowrap;
  }

  /* Mobile base — burger visible, links hidden as dropdown */
  .nav-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    padding: 0 11px;
    flex-shrink: 0;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition: transform var(--transition-base), opacity var(--transition-fast);
  }
  .nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-links {
    display: none;
    flex-direction: column;
    list-style: none;
    position: absolute;
    top: var(--nav-height);
    left: 0;
    right: 0;
    background: var(--color-green-dark);
    padding: var(--space-1) 0 var(--space-3);
    border-top: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 12px 24px rgba(0,0,0,0.2);
  }
  .nav-links.open { display: flex; animation: menu-in 200ms ease; }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-links.open { animation: none; }
  }
  .nav-links a {
    color: rgba(255,255,255,0.82);
    text-decoration: none;
    font-size: var(--size-lg);
    padding: 14px var(--gutter);
    display: block;
  }
  .nav-links a:hover { color: var(--color-white); }
  .nav-links a[aria-current="true"] { color: var(--color-white); font-weight: var(--weight-bold); }
  .nav-links .nav-cta { color: var(--color-sun); font-weight: var(--weight-bold); }

  @media (min-width: 400px) {
    .brand-sub { font-size: 0.72rem; }
  }
  @media (max-width: 380px) {
    .brand-sub { display: none; }
    .brand-mark { width: 40px; height: 40px; }
  }

  /* Desktop — inline nav, no burger */
  @media (min-width: 960px) {
    .nav-burger { display: none; }
    .nav-links {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 2px;
      position: static;
      background: none;
      padding: 0;
      border-top: none;
      box-shadow: none;
    }
    .nav-links a {
      font-size: var(--size-sm);
      font-weight: var(--weight-medium);
      padding: 8px 12px;
      border-radius: var(--radius-pill);
    }
    .nav-links a[aria-current="true"] { background: rgba(255,255,255,0.1); }
    .nav-links .nav-cta {
      margin-left: 10px;
      padding: 10px 18px;
      background: var(--color-accent);
      color: var(--color-white);
    }
    .nav-links .nav-cta:hover,
    .nav-links .nav-cta[aria-current="true"] { background: var(--color-accent-hover); color: var(--color-white); }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const links = document.getElementById('nav-links');
  const closeMenu = () => {
    links?.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
  };
  burger?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  links?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

  // Stronger shadow once the page is scrolled
  const navWrap = document.querySelector('.nav-wrap');
  const onScroll = () => navWrap?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scrollspy — highlight the nav link for the section in view
  const navAnchors = [...(links?.querySelectorAll('a') ?? [])];
  const sections = navAnchors
    .map(a => document.getElementById(a.hash?.slice(1) ?? ''))
    .filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          navAnchors.forEach(a =>
            a.setAttribute('aria-current', a.hash === `#${e.target.id}` ? 'true' : 'false'));
        }
      }
    }, { rootMargin: '-40% 0px -55% 0px' });
    sections.forEach(s => spy.observe(s));
  }
</script>
